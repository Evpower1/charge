# Local preview only. Never enable this on a publicly accessible production deployment.
APP_DEMO_MODE=true
# Set to the canonical HTTPS origin in production.
APP_URL=http://localhost:3000
# Add the secret securely on the deployment server; never expose it to the browser.
CHAPA_SECRET_KEY=
# Create the initial administrator by setting both values before the first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DATABASE_PATH=.data/evpower.sqlite
