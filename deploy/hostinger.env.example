# Configure these in Hostinger's application environment settings.
# This file contains no credentials. Do not upload a filled-in copy publicly.
NODE_ENV=production
APP_URL=https://evpower.et
APP_DEMO_MODE=false

# Replace with an ABSOLUTE, private, persistent location supplied by Hostinger.
# Do not keep the production database under public_html or a replaced build directory.
DATABASE_PATH=/REPLACE_WITH_PRIVATE_PERSISTENT_DIRECTORY/evpower.sqlite

# Supply these securely in hPanel, not in a ZIP or this chat.
# Choose an administrator email that has not already registered as a customer.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CHAPA_SECRET_KEY=
