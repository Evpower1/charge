NODE_ENV=development
HOST=127.0.0.1
PORT=4100
DATABASE_PATH=.data/mobile.sqlite
API_PUBLIC_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082,http://127.0.0.1:8081
# Only exact IPs of your own reverse proxy. Leave empty for direct local access.
TRUSTED_PROXY_IPS=
DEMO_MODE=false

# Explicit opt-in. An inherited CHAPA_SECRET_KEY alone never enables payments.
# Require an HTTPS public URL and both merchant credentials before enabling.
PAYMENTS_ENABLED=false
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# A random, separate integration secret shared only with your charger gateway.
TELEMETRY_INGEST_KEY=

# SMTP connection URL and verified sender; keep passwords in your secret manager.
SMTP_URL=
MAIL_FROM=
