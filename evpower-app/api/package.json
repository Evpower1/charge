{
  "name": "evpower-mobile-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.2.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "admin": "node --env-file-if-exists=.env src/cli.mjs admin",
    "demo:stations": "node --env-file-if-exists=.env src/cli.mjs demo-stations"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "fastify": "5.12.8",
    "nodemailer": "10.5.0",
    "zod": "4.6.7"
  }
}
